# Fill manually for a new development deployment. Never commit the filled file.
# Migration credentials belong only to migrate/admin, never server or worker.
BID_OWNER_PASSWORD=
BID_DATABASE_PASSWORD=
# Optional password provisioning for dedicated roles; migrate/admin only.
BID_PLATFORM_DATABASE_PASSWORD=
BID_CREDENTIAL_DATABASE_PASSWORD=
BID_MIGRATION_DATABASE_URL=postgresql+psycopg://bid_owner:URL_ENCODED_PASSWORD@postgres/bid
BID_DATABASE_URL=postgresql+psycopg://bid_app:URL_ENCODED_PASSWORD@postgres/bid
# Separate restricted logins, provisioned after migration; never reuse the owner or bid_app.
BID_PLATFORM_DATABASE_URL=postgresql+psycopg://bid_platform_app:URL_ENCODED_PASSWORD@postgres/bid
BID_CREDENTIAL_DATABASE_URL=postgresql+psycopg://bid_credential_reader:URL_ENCODED_PASSWORD@postgres/bid
# Fernet key for stored files and encrypted fields.
BID_ENCRYPTION_KEY=
# Retired data keys, comma separated, kept only until rotate-encryption finishes.
BID_ENCRYPTION_KEY_PREVIOUS=
# Separate Fernet key for sessions and signed download links.
BID_TOKEN_KEY=
# Independent Fernet domain for BYOK history and platform credentials, shared by all callers.
BID_SECRETS_KEY=
# Retired provider-secrets keys; decryption only, comma separated.
BID_SECRETS_KEY_PREVIOUS=
BID_CLI_KEY=
# S3 mode is optional; create the private bucket explicitly before enabling it.
BID_STORAGE=local
BID_DATA_DIR=data
BID_S3_ENDPOINT=http://127.0.0.1:9000
BID_S3_CONTAINER_ENDPOINT=http://minio:9000
BID_S3_BUCKET=bid
BID_S3_ACCESS_KEY=
BID_S3_SECRET_KEY=
BID_OCR_LANGUAGE=chi_sim+eng
BID_OCR_DATA_DIR=
# One disposable child per PDF validation, document parse or page render.
# Wall deadline excludes OCR provider calls; CPU is cumulative child CPU time.
# Size both for the largest accepted scanned document (BID_MAX_PAGES), not a page.
BID_PDF_TIMEOUT_SECONDS=600
BID_PDF_CPU_SECONDS=300
# Linux production: RLIMIT_AS and RLIMIT_DATA; neither is enforced on macOS.
BID_PDF_MEMORY_BYTES=1073741824
# Total private result spool (JSON/base64 PNGs); prevents unbounded temporary output.
BID_PDF_OUTPUT_BYTES=268435456
# Standalone adapter/eval settings. API and worker resolve org config, then catalog default.
# These variables no longer supply a tenant job's fallback model.
BID_LLM_PROVIDER=disabled
BID_LLM_MODEL=
BID_LLM_BASE_URL=
BID_LLM_EFFORT=high
BID_LLM_ANTHROPIC_FALLBACK=true
BID_LLM_JSON_MODE=json_schema
BID_LLM_BATCH_CHARS=8000
# Serialized ScoreProviderRequest characters, including selected evidence and metadata.
# Leave model context room for prompts, schema and output; characters are not tokens.
# Complete items exceeding this independent limit block preview with score_context_limit.
BID_SCORE_BATCH_CHARS=64000
# Rubric stage 1 sends the entire scoring table in one request. This limit counts
# the complete serialized HTTP JSON request in UTF-8 bytes: messages, schema and vendor options.
# 196608 = 192 KiB is a long-context deployment budget, independent of extraction batches.
# As a conservative reference, treating each input byte as a token plus a 4096 envelope allowance
# and the default 32000 output ceiling totals 232704, leaving room below a 256 Ki-token context.
# Bytes are not tokens; this is not a guarantee a model accepts the request. Adjust this limit
# and BID_LLM_MAX_OUTPUT_TOKENS to the chosen model's context/output limits and tokenizer.
# Stage 1 rejects oversized complete tables before calls; it never splits the table.
# Stage 2 groups requirements by BID_LLM_BATCH_CHARS with the fixed section list; each
# full request must fit this byte limit. Oversized item batches remain unresolved.
BID_RUBRIC_MAX_REQUEST_BYTES=196608
BID_LLM_CONCURRENCY=4
# Drafting batches are this many times the extraction batch budget (requirements are short).
BID_DRAFTING_BATCH_SCALE=4
BID_LLM_MAX_OUTPUT_TOKENS=32000
BID_LLM_TIMEOUT_SECONDS=600
# JSON object added to every request body, e.g. {"thinking":{"type":"disabled"}}
BID_LLM_REQUEST_OPTIONS=
BID_LLM_INPUT_USD_PER_MTOK=
BID_LLM_OUTPUT_USD_PER_MTOK=
# Platform operators: emails plus one TOTP secret each (python -m app.admin platform-totp).
BID_PLATFORM_ADMIN_EMAILS=
BID_PLATFORM_TOTP_SECRETS=
# Vendor keys are managed in the platform console; legacy key variables are forbidden.
# Absolute path to the built console (web/dist); leave empty to serve no console.
BID_WEB_DIR=
# Currency of sale prices, charges, balances and recharge cards (ISO 4217).
BID_BILLING_CURRENCY=USD
# Vendor-source search (SearXNG). Compose sets the internal URL; local runs use 127.0.0.1:8888.
BID_SEARCH_URL=
# Explicit selection: disabled (default), searxng or perplexity. No automatic fallback.
BID_SEARCH_PROVIDER=disabled
SEARXNG_SECRET=
# Export page previews (Gotenberg). Compose sets the internal URL; local runs use 127.0.0.1:3300.
BID_CONVERTER_URL=
# Shared job budgets across attempts; charge is in BID_BILLING_CURRENCY.
BID_JOB_MAX_CHARGE=10
BID_JOB_MAX_VENDOR_CALLS=64
# Vendor calls allowed per first-pass batch; the per-job ceiling is the larger of the two.
BID_JOB_VENDOR_CALLS_PER_BATCH=4
# Heartbeat must be positive and at most one third of the lease.
BID_JOB_LEASE_SECONDS=900
BID_JOB_HEARTBEAT_SECONDS=30
