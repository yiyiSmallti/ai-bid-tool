# Fill manually for a new development deployment. Never commit the filled file.
# Migration credentials belong only to migrate/admin, never server or worker.
BID_OWNER_PASSWORD=
BID_DATABASE_PASSWORD=
BID_MIGRATION_DATABASE_URL=postgresql+psycopg://bid_owner:URL_ENCODED_PASSWORD@postgres/bid
BID_DATABASE_URL=postgresql+psycopg://bid_app:URL_ENCODED_PASSWORD@postgres/bid
BID_ENCRYPTION_KEY=
BID_CLI_KEY=
# S3 mode is optional; create the private bucket explicitly before enabling it.
BID_STORAGE=local
BID_DATA_DIR=data
BID_S3_ENDPOINT=http://127.0.0.1:9000
BID_S3_CONTAINER_ENDPOINT=http://minio:9000
BID_S3_BUCKET=bid
BID_S3_ACCESS_KEY=
BID_S3_SECRET_KEY=
BID_OCR_LANGUAGE=chi_sim+eng
BID_OCR_DATA_DIR=
# Platform extraction model: disabled, anthropic or openai (any OpenAI-compatible service).
# Leave disabled to make extraction fail explicitly. Fill the key only in the ignored env file.
BID_LLM_PROVIDER=disabled
BID_LLM_MODEL=
BID_LLM_API_KEY=
BID_LLM_BASE_URL=
BID_LLM_EFFORT=high
BID_LLM_ANTHROPIC_FALLBACK=true
BID_LLM_JSON_MODE=json_schema
BID_LLM_BATCH_CHARS=30000
BID_LLM_MAX_OUTPUT_TOKENS=16000
BID_LLM_INPUT_USD_PER_MTOK=
BID_LLM_OUTPUT_USD_PER_MTOK=
