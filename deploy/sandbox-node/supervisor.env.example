# Supervisor environment for the dedicated sandbox VM (/etc/bid-sandbox/supervisor.env,
# root:bidsbx 0640). Values in angle brackets come from the image build, the seccomp file
# and the mTLS certificates; none of them is a business credential.
BID_SANDBOX_ENABLED=1
BID_SANDBOX_TRANSPORT=mtls
BID_SANDBOX_HOST=127.0.0.1
BID_SANDBOX_PORT=8443
BID_SANDBOX_BIND_HOST=127.0.0.1
BID_SANDBOX_TLS_SERVER_NAME=127.0.0.1
BID_SANDBOX_TLS_CA=/etc/bid-sandbox/tls/ca.pem
BID_SANDBOX_TLS_CERT=/etc/bid-sandbox/tls/server.pem
BID_SANDBOX_TLS_KEY=/etc/bid-sandbox/tls/server.key
BID_SANDBOX_TLS_SERVER_SHA256=<server leaf DER sha256>
BID_SANDBOX_TLS_CLIENT_SHA256=<client leaf DER sha256>
BID_SANDBOX_IMAGE=127.0.0.1:5000/bid-sandbox@sha256:<image id>
# Development VM only: runc with synthetic inputs. See the runtime guide before using runsc.
BID_SANDBOX_RUNTIME=runc
BID_SANDBOX_SYNTHETIC_ONLY=1
BID_SANDBOX_RUNTIME_ACCEPTED=1
BID_SANDBOX_SECCOMP=/etc/bid-sandbox/seccomp.json
BID_SANDBOX_SECCOMP_SHA256=<sha256 of deploy/sandbox-seccomp.json>
BID_SANDBOX_DOCKER_SOCKET=/run/user/1000/docker.sock
BID_SANDBOX_STATE=/var/lib/bid-sandbox/supervisor.sqlite3
PYTHONPATH=/opt/bid-supervisor
