# Copy to gateway.env (mode 0600) beside compose.yml. Generate each secret on the
# gateway host; passwords go into URLs unencoded, so use `openssl rand -hex 24`.
BID_IMAGE=bid-gateway:local
BID_COMPANY_NAME=
BID_GATEWAY_HOST=gateway.example.com
BID_PUBLIC_URL=https://gateway.example.com
# ACME contact email for a public certificate, or "internal" without public DNS.
BID_TLS=
BID_OWNER_PASSWORD=
BID_DATABASE_PASSWORD=
# Fernet keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BID_ENCRYPTION_KEY=
BID_TOKEN_KEY=
BID_SECRETS_KEY=
# Host-only key for the admin command line; never given to members.
BID_ACCESS_KEY=
# local keeps files in the "files" volume; s3 needs the four S3 settings.
BID_STORAGE=local
BID_S3_ENDPOINT=
BID_S3_BUCKET=bid
BID_S3_ACCESS_KEY=
BID_S3_SECRET_KEY=
